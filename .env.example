# Copy this file to .env and add local secrets. Never commit the populated .env file.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANKER_MODEL=gpt-5-mini
OPENAI_RERANKER_VERSION=configured
RERANKER_FAILURE_POLICY=heuristic_fallback
RERANKER_TIMEOUT_SECONDS=4
RERANKER_MAX_CANDIDATES=20
RERANKER_MAX_TEXT_CHARS=1200
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_SECONDS=60
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=28
AGENT_REASONING_EFFORT=low
AGENT_MAX_COST_USD=0.25
# GPT-5 mini standard pricing per 1,000 tokens (verify before changing models).
AGENT_INPUT_COST_PER_1K_TOKENS=0.00025
AGENT_OUTPUT_COST_PER_1K_TOKENS=0.002

# Mem0 Platform
MEM0_API_KEY=

# Langfuse self-hosted observability (make observability-up)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_DEBUG=false
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=admin@civil-copilot.local
LANGFUSE_INIT_USER_NAME=Civil Copilot Admin
LANGFUSE_INIT_USER_PASSWORD=

# PostgreSQL — authoritative structured project records
DATABASE_URL=postgresql://civil_copilot:change-me@127.0.0.1:55432/civil_copilot

# Qdrant — document and vector retrieval
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Neo4j — project relationship graph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Local application settings
COPILOT_RUNTIME_MODE=live
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8011
COPILOT_API_URL=http://127.0.0.1:8011
COPILOT_PUBLIC_API_URL=http://127.0.0.1:8011
