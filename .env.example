# Copy this file to .env and add local secrets. Never commit the populated .env file.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Mem0 Platform
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_DEBUG=false

# PostgreSQL — authoritative structured project records
DATABASE_URL=postgresql://civil_copilot:change-me@localhost:55432/civil_copilot

# Qdrant — document and vector retrieval
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j — project relationship graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Local application settings
APP_ENV=development
LOG_LEVEL=INFO
