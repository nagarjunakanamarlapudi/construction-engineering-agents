# Copy this file to .env and add local secrets. Never commit the populated .env file.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Mem0 Platform
MEM0_API_KEY=

# Langfuse self-hosted observability (make observability-up)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_DEBUG=false
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=admin@civil-copilot.local
LANGFUSE_INIT_USER_NAME=Civil Copilot Admin
LANGFUSE_INIT_USER_PASSWORD=

# PostgreSQL — authoritative structured project records
DATABASE_URL=postgresql://civil_copilot:change-me@127.0.0.1:55432/civil_copilot

# Qdrant — document and vector retrieval
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Neo4j — project relationship graph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Local application settings
APP_ENV=development
LOG_LEVEL=INFO
